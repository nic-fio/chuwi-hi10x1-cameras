+/**
+ * __media_pipeline_remove_entity_pads - Detach an entity's pads from the
+ *	pipeline they belong to
+ *
+ * @entity: The entity going away
+ *
+ * Nothing holds an entity in place while a pipeline references its pads, so
+ * an entity unregistered while a pipeline is streaming leaves that pipeline
+ * with dangling pointers. Drop the entity's pads from the pipeline before
+ * they are freed.
+ *
+ * .. note:: Requires the media device graph_mutex to be held.
+ */
+void __media_pipeline_remove_entity_pads(struct media_entity *entity);
