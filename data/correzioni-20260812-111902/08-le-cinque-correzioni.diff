diff --git a/drivers/media/mc/mc-device.c b/drivers/media/mc/mc-device.c
index f8ea7cfe1..0ebbda816 100644
--- a/drivers/media/mc/mc-device.c
+++ b/drivers/media/mc/mc-device.c
@@ -592,6 +592,13 @@ static void __media_device_unregister_entity(struct media_entity *entity)
 	/* Remove all data links that belong to this entity */
 	__media_entity_remove_links(entity);
 
+	/*
+	 * Drop the entity's pads from the pipeline they belong to, if any.
+	 * A streaming pipeline keeps a list of the pads it walked, and
+	 * nothing keeps this entity alive while that list references it.
+	 */
+	__media_pipeline_remove_entity_pads(entity);
+
 	/* Remove all pads that belong to this entity */
 	media_entity_for_each_pad(entity, iter)
 		media_gobj_destroy(&iter->graph_obj);
diff --git a/drivers/media/mc/mc-entity.c b/drivers/media/mc/mc-entity.c
index 3fa0bc687..d91d8bd5b 100644
--- a/drivers/media/mc/mc-entity.c
+++ b/drivers/media/mc/mc-entity.c
@@ -952,6 +952,30 @@ void __media_pipeline_stop(struct media_pad *pad)
 }
 EXPORT_SYMBOL_GPL(__media_pipeline_stop);
 
+void __media_pipeline_remove_entity_pads(struct media_entity *entity)
+{
+	struct media_pad *pad;
+
+	media_entity_for_each_pad(entity, pad) {
+		struct media_pipeline_pad *ppad, *tmp;
+		struct media_pipeline *pipe = pad->pipe;
+
+		if (!pipe)
+			continue;
+
+		list_for_each_entry_safe(ppad, tmp, &pipe->pads, list) {
+			if (ppad->pad != pad)
+				continue;
+
+			list_del(&ppad->list);
+			kfree(ppad);
+		}
+
+		pad->pipe = NULL;
+	}
+}
+EXPORT_SYMBOL_GPL(__media_pipeline_remove_entity_pads);
+
